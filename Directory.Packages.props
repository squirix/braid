<Project>
    <PropertyGroup Label="CentralPackageManagement">
        <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
        <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
    </PropertyGroup>

    <!-- Solution-wide Roslyn analyzers (see Directory.Build.props / GlobalAnalyzers). -->
    <ItemGroup Label="Analyzers">
        <PackageVersion Include="AsyncFixer" Version="2.1.0"/>
        <PackageVersion Include="ErrorProne.NET.CoreAnalyzers" Version="0.9.0-beta.4"/>
        <PackageVersion Include="ErrorProne.NET.Structs" Version="0.6.1-beta.1"/>
        <PackageVersion Include="Meziantou.Analyzer" Version="3.0.152"/>
        <PackageVersion Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="5.6.0"/>
        <PackageVersion Include="Microsoft.CodeAnalysis.NetAnalyzers" Version="10.0.400"/>
        <PackageVersion Include="Microsoft.VisualStudio.Threading.Analyzers" Version="18.7.23"/>
        <PackageVersion Include="Roslynator.Analyzers" Version="4.16.0"/>
        <PackageVersion Include="SonarAnalyzer.CSharp" Version="10.32.0.713"/>
        <PackageVersion Include="StyleCop.Analyzers" Version="1.2.0-beta.556"/>
        <PackageVersion Include="ZeroAlloc.Analyzers" Version="1.5.0"/>
        <PackageVersion Include="JetBrains.Annotations" Version="2026.2.0"/>
    </ItemGroup>

    <!-- Test-project analyzers (see Directory.Build.props / TestAnalyzers). -->
    <ItemGroup Label="TestAnalyzers">
        <PackageVersion Include="xunit.analyzers" Version="1.27.0"/>
    </ItemGroup>

    <ItemGroup Label="Testing">
        <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.9.0"/>
        <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5"/>
        <PackageVersion Include="xunit.v3" Version="3.2.2"/>
    </ItemGroup>
</Project>
