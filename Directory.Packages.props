<Project>
    <PropertyGroup Label="CentralPackageManagement">
        <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
        <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
    </PropertyGroup>

    <!-- Solution-wide Roslyn analyzers (see Directory.Build.props / GlobalAnalyzers). -->
    <ItemGroup Label="Analyzers">
        <PackageVersion Include="AsyncFixer" Version="2.1.0"/>
        <PackageVersion Include="ErrorProne.NET.CoreAnalyzers" Version="0.9.0-beta.4"/>
        <PackageVersion Include="Meziantou.Analyzer" Version="3.0.317"/>
        <PackageVersion Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="5.6.0"/>
        <PackageVersion Include="Microsoft.CodeAnalysis.NetAnalyzers" Version="10.0.403"/>
        <PackageVersion Include="Microsoft.VisualStudio.Threading.Analyzers" Version="18.12.1"/>
        <PackageVersion Include="Roslynator.Analyzers" Version="5.0.1"/>
        <PackageVersion Include="SonarAnalyzer.CSharp" Version="10.35.0.4138"/>
        <PackageVersion Include="StyleCopNext.Analyzers" Version="1.0.13"/>
        <PackageVersion Include="ZeroAlloc.Analyzers" Version="1.11.3"/>
        <PackageVersion Include="squirix.analyzers" Version="0.1.17"/>
        <PackageVersion Include="JetBrains.Annotations" Version="2026.2.0"/>
    </ItemGroup>

    <!-- Test-project analyzers ship inside the TUnit package (see Braid.Tests.csproj). -->
    <ItemGroup Label="Testing">
        <PackageVersion Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.12.0"/>
        <PackageVersion Include="TUnit" Version="1.75.0"/>
    </ItemGroup>
</Project>
