<Project>
    <PropertyGroup Label="CentralPackageManagement">
        <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
        <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
    </PropertyGroup>

    <!-- Solution-wide Roslyn analyzers (see Directory.Build.props / GlobalAnalyzers). -->
    <ItemGroup Label="Analyzers">
        <PackageVersion Include="AsyncFixer" Version="2.1.0"/>
        <PackageVersion Include="ErrorProne.NET.CoreAnalyzers" Version="0.9.0-beta.4"/>
        <PackageVersion Include="ErrorProne.NET.Structs" Version="0.6.1-beta.1"/>
        <PackageVersion Include="Meziantou.Analyzer" Version="3.0.259"/>
        <PackageVersion Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="5.6.0"/>
        <PackageVersion Include="Microsoft.CodeAnalysis.NetAnalyzers" Version="10.0.401"/>
        <PackageVersion Include="Microsoft.VisualStudio.Threading.Analyzers" Version="18.7.23"/>
        <PackageVersion Include="Roslynator.Analyzers" Version="5.0.0"/>
        <PackageVersion Include="SonarAnalyzer.CSharp" Version="10.34.0.3385"/>
        <PackageVersion Include="StyleCop.Analyzers" Version="1.2.0-beta.556"/>
        <PackageVersion Include="ZeroAlloc.Analyzers" Version="1.5.3"/>
        <PackageVersion Include="squirix.analyzers" Version="0.1.8"/>
        <PackageVersion Include="JetBrains.Annotations" Version="2026.2.0"/>
    </ItemGroup>

    <!-- Test-project analyzers ship inside the TUnit package (see Braid.Tests.csproj). -->
    <ItemGroup Label="Testing">
        <PackageVersion Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.11.2"/>
        <PackageVersion Include="TUnit" Version="1.68.17"/>
    </ItemGroup>
</Project>
