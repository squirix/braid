<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
        <IsPackable>false</IsPackable>
        <OutputType>Exe</OutputType>
        <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
        <UseAppHost>true</UseAppHost>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="../../src/braid/Braid.csproj"/>
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="TUnit"/>
    </ItemGroup>
    <ItemGroup>
        <PackageReference Update="Microsoft.CodeAnalysis.NetAnalyzers" VersionOverride="$(NetAnalyzersNet10Version)" Condition="'$(TargetFramework)' == 'net10.0'"/>
        <PackageReference Update="Microsoft.CodeAnalysis.NetAnalyzers" VersionOverride="$(NetAnalyzersNet11Version)" Condition="'$(TargetFramework)' == 'net11.0'"/>
    </ItemGroup>
</Project>
